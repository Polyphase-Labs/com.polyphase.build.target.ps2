# ---- Include path -----------------------------------------------------------
# PS2SDK's Makefile.eeglobal_cpp consumes EE_INCS (with -I prefix per item)
# rather than PSP's bare INCDIR list. We build EE_INCS via addprefix.
INC_DIRS = \
    $(PROJECT_ROOT)/Generated \
    $(ADDON_PS2_RUNTIME) \
    $(ADDON_PS2_RUNTIME)/Graphics_PS2GS \
    $(POLYPHASE_PATH)/Engine/Source \
    $(POLYPHASE_PATH)/Engine/Source/Engine \
    $(POLYPHASE_PATH)/External \
    $(POLYPHASE_PATH)/External/Bullet \
    $(POLYPHASE_PATH)/External/Lua \
    $(POLYPHASE_PATH)/External/glm \
    $(POLYPHASE_PATH)/External/Vorbis \
    $(POLYPHASE_PATH)/External/Assimp/contrib/rapidjson \
    $(POLYPHASE_PATH)/External/recastnavigation/Recast/Include \
    $(POLYPHASE_PATH)/External/recastnavigation/Detour/Include \
    $(POLYPHASE_PATH)/Engine/External/PolyVox/include \
    $(PS2SDK)/ports/include \
    $(PS2DEV)/gsKit/include \
    $(ADDON_INCDIR)

EE_INCS = $(addprefix -I,$(INC_DIRS))

# ---- Object list ------------------------------------------------------------
# Flat-basename .o placed in CWD; VPATH tells make where to find each source.
CPPFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
CFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))

# Embedded scripts only — NEVER include EmbeddedAssets.cpp (PS2 main RAM is
# 32 MB, the same budget as PSP). Asset bytes load from disc / mc0:/ at
# runtime via AssetManager::Discover.
ifneq ($(wildcard $(PROJECT_ROOT)/Generated/EmbeddedScripts.cpp),)
CPPFILES += EmbeddedScripts.cpp
endif

# Engine-target addon registrar (AddonPlugins.cpp etc.) contributed by
# AddonInject.mk.
CPPFILES += $(ADDON_CPPFILES_EXTRA)

VPATH := $(SOURCES) $(PROJECT_ROOT)/Generated
EE_OBJS := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

# ---- VU1 microcode ----------------------------------------------------------
# The VU1 rendering pipeline is hand-written vector-unit assembly vendored from
# XTC (https://github.com/aap/xtc, MIT — see vu1/LICENSE.xtc). It is assembled
# by `dvp-as`, a SEPARATE assembler from ee-gcc: it targets the VU/DMA/VIF
# instruction set, not MIPS, and emits .vutext/.vudata sections that the EE
# linker places into the ELF like any other object.
#
# Verified 2026-09-10: ps2dev ships GNU binutils 2.45.1 built for the `dvp`
# target, and it accepts XTC's Sony-syntax source (DMAret / MPG / .EndMPG /
# .EndDmaData / .vu mode) unmodified. The resulting object links cleanly into a
# mips64r5900el-ps2-elf ELF with all relocations resolved.
#
# Two-step, mirroring xtc/Makefile:
#   1. joinvu strips `;' comments and joins backslash continuations, so that
#      the C preprocessor can run over VU assembly (cpp would choke on `;'
#      comments and on multi-line macros otherwise).
#   2. cpp expands the #define'd register/attribute accessors, `grep -v '^#''
#      drops the resulting line markers (dvp-as has no use for them), and
#      dvp-as assembles.
#
# NOT passed (they are SCE ee-dvp-as options that GNU dvp-as does not have):
#   -stalls-pipeline  the microcode is hand-scheduled with explicit nops
#   -no-fetching      likewise
#   -alm=             produced a listing file we do not consume
VU1_DIR    := $(ADDON_PS2_RUNTIME)/Graphics_PS2GS/vu1
DVP_AS     := $(PS2DEV)/dvp/bin/dvp-as
VU1_DSM    := $(wildcard $(VU1_DIR)/*.dsm)
VU1_OBJS   := $(notdir $(VU1_DSM:.dsm=.o))
# Every .dsm .include's the .vu/.inc fragments beside it, so any of them
# changing must force a re-assemble.
VU1_DEPS   := $(wildcard $(VU1_DIR)/*.vu) $(wildcard $(VU1_DIR)/*.inc)

# joinvu is invoked through `sh` rather than executed directly: the addon tree
# is usually on an NTFS mount inside WSL, where the executable bit does not
# survive, so ./joinvu would fail with "Permission denied".
%.o: $(VU1_DIR)/%.dsm $(VU1_DEPS)
	sh $(VU1_DIR)/joinvu $< | $(EE_CC) -E -x assembler-with-cpp -I$(VU1_DIR) - \
	    | grep -v '^#' > $*.dsm_x
	$(DVP_AS) -I$(VU1_DIR) $*.dsm_x -o $@

EE_OBJS += $(VU1_OBJS)

# ---- audsrv.irx embedding ---------------------------------------------------
# audsrv runs on the IOP and is the standard PS2 software audio mixer. We
# embed audsrv.irx into the ELF so SifLoadModuleBuffer can hand it to the
# IOP from EE RAM (works under PCSX2 -elf and from disc alike — no separate
# IRX file alongside the ELF needed).
#
# Mechanism: objcopy --input binary converts the raw IRX bytes directly to
# an EE-elf .o file. The resulting object has three auto-generated symbols
# matching `_binary_<basename>_start/_end/_size`. Renaming the section
# from .data to .rodata reduces RAM footprint (the bytes go into the ROM
# image / read-only segment instead of being copied at runtime).
#
# Why not `.incbin`: it works in theory but the path quoting through
# successive make/shell layers was producing a truncated IRX (-201 from
# the IOP loader = bad header), and objcopy sidesteps the entire mess.
# Why not bin2s: PS2SDK doesn't ship it.
AUDSRV_IRX_SRC := $(PS2SDK)/iop/irx/audsrv.irx
# Depend on the Makefile itself so any change to the recipe forces a
# rebuild of the .o — GNU make only watches file deps by default, not
# recipe changes.
#
# Mechanism: `$(PS2SDK)/bin/bin2c` generates a C source file declaring
#   unsigned char audsrv_irx[] = { 0x7f, 0x45, 0x4c, 0x46, ... };
#   unsigned int  size_audsrv_irx = sizeof(audsrv_irx);
# This is the canonical PS2SDK pattern — matches what ps2sdk-ports/SDL
# and most homebrew use to embed IRX modules. The compiler handles
# alignment + section placement (.rodata by default with -O2), and the
# resulting .o has no ABI ambiguity since it's just a regular C object.
#
# `ld -r -b binary` produced bytes that the IOP loader rejected with -201
# (KE_LINKERR) — likely missing alignment, missing const-ness, or a
# section attribute mismatch. bin2c sidesteps the whole class of issues.
audsrv_irx.c: $(AUDSRV_IRX_SRC) $(ADDON_PS2_RUNTIME)/../../Makefile_PS2
	rm -f $@
	$(PS2SDK)/bin/bin2c $< $@ audsrv_irx
audsrv_irx.o: audsrv_irx.c
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@
EE_OBJS += audsrv_irx.o

# ---- MMCE (SD2PSX / MemCard PRO) --------------------------------------------
# mmceman exposes the device's REAL SD filesystem as mmce0:, separate from the
# 8 MB emulated memory card at mc0:. That matters for shipping a build to one:
# a full asset tree does not fit in an 8 MB card image, but does fit on the SD.
# mmcedrv adds the faster bulk-transfer path; without it mmceman still works,
# just slower, so a failure to load it is not fatal.
# mmceman imports iomanX (the extended I/O manager) and registers through it,
# NOT through plain ioman. Without iomanX + fileXio the module load fails with
# -200 and mmce0: never exists, which is exactly what hardware showed.
IOMANX_IRX_SRC  = $(PS2SDK)/iop/irx/iomanX.irx
FILEXIO_IRX_SRC = $(PS2SDK)/iop/irx/fileXio.irx
MMCEMAN_IRX_SRC = $(PS2SDK)/iop/irx/mmceman.irx
MMCEDRV_IRX_SRC = $(PS2SDK)/iop/irx/mmcedrv.irx

iomanx_irx.c: $(IOMANX_IRX_SRC) $(ADDON_PS2_RUNTIME)/../../Makefile_PS2
	rm -f $@
	$(PS2SDK)/bin/bin2c $< $@ iomanx_irx
iomanx_irx.o: iomanx_irx.c
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@
EE_OBJS += iomanx_irx.o

filexio_irx.c: $(FILEXIO_IRX_SRC) $(ADDON_PS2_RUNTIME)/../../Makefile_PS2
	rm -f $@
	$(PS2SDK)/bin/bin2c $< $@ filexio_irx
filexio_irx.o: filexio_irx.c
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@
EE_OBJS += filexio_irx.o

mmceman_irx.c: $(MMCEMAN_IRX_SRC) $(ADDON_PS2_RUNTIME)/../../Makefile_PS2
	rm -f $@
	$(PS2SDK)/bin/bin2c $< $@ mmceman_irx
mmceman_irx.o: mmceman_irx.c
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@
EE_OBJS += mmceman_irx.o

mmcedrv_irx.c: $(MMCEDRV_IRX_SRC) $(ADDON_PS2_RUNTIME)/../../Makefile_PS2
	rm -f $@
	$(PS2SDK)/bin/bin2c $< $@ mmcedrv_irx
mmcedrv_irx.o: mmcedrv_irx.c
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@
EE_OBJS += mmcedrv_irx.o

# ---- Flags ------------------------------------------------------------------
# Variant 2 platform-extension flag plus PS2-native macros. Makefile.eeglobal_cpp
# will prepend -D_EE -G0 -O2 etc. — do NOT add -G0 ourselves; overriding breaks
# the small-data area which PS2 link relies on.
DEFINES = \
    -DPOLYPHASE_PLATFORM_ADDON=1 \
    -DPLATFORM_PS2=1 \
    -DAPI_PS2GS=1 \
    -DEDITOR=0 \
    -DLUA_ENABLED=1 \
    -DGLM_FORCE_RADIANS \
    -DGLM_FORCE_UNRESTRICTED_GENTYPE \
    -DLOGGING_ENABLED=1 \
    $(addprefix -D,$(ADDON_DEFINES))

# Why GLM_UNRESTRICTED_GENTYPE: PS2's R5900 EE FPU is not IEC559-conformant
# (no NaN, no denormals — Sony optimised for game speed over IEEE 754
# correctness). std::numeric_limits<float>::is_iec559 is therefore `false`
# on PS2, and GLM's clamp/round/etc. static_assert that input types are
# `is_iec559 || is_integer`, which rejects PS2 float. The escape hatch
# GLM_UNRESTRICTED_GENTYPE adds a third branch (`|| true`) to the assert
# so PS2 float passes — at the cost of nominal type-safety on those funcs.
# Same workaround used by every PS2 homebrew that includes GLM.

# -MMD -MP: emit a <obj>.d header-dependency file next to every object and
# pull them all back in (see the -include near the end). Without this, make
# only compares each .o against its own .cpp, so an engine header edit (a
# struct gaining a field, a function gaining a defaulted parameter) leaves
# every other TU stale: "undefined reference to <old signature>" at link
# time, or objects that link but read a struct with the wrong layout.
DEPFLAGS = -MMD -MP
EE_CFLAGS   = -Wall -Wno-unused-parameter -Wno-unused-variable $(DEFINES) $(DEPFLAGS)
EE_CXXFLAGS = $(EE_CFLAGS) -fno-exceptions -fno-rtti -std=gnu++17
EE_ASFLAGS  = $(EE_CFLAGS)

# ---- Libraries --------------------------------------------------------------
# gsKit + dmaKit live in $(PS2SDK)/ports/lib. Standard EE libs (-lkernel, -lc)
# are in $(PS2SDK)/ee/lib. Order is strict left-to-right ld resolution:
# gsKit_toolkit → gsKit → dmaKit → packet2 → dma → patches → debug → m → c → kernel.
#
# -lpacket2 / -ldma are ps2sdk's own DMA/VIF packet builder and DMA channel
# driver, used by the VU1 geometry path (Runtime/PS2/Graphics_PS2GS/
# PS2VU1Pipe.cpp): packet2_create/reset/free come from libpacket2, while
# dma_channel_send_packet2 and dma_channel_wait come from libdma. Neither
# references the other, so their relative order is free — but both must precede
# -lc / -lkernel. These are distinct from gsKit's own dmaKit, which only opens
# and configures channels and cannot send a packet2 chain.
#
# Phase 0-2 doesn't need libpad / libmc / audsrv — those arrive with the
# respective subsystem implementations in Phase 3+.
#
# fileXio is kept now for future filesystem extension; engine builds without
# touching it in Phase 0-2.
EE_LIBDIR = -L$(PS2SDK)/ports/lib -L$(PS2SDK)/ee/lib -L$(PS2DEV)/gsKit/lib $(addprefix -L,$(ADDON_LIBDIR))
# --allow-multiple-definition: video addon's StbImageJpeg.cpp also defines
# STB_IMAGE_IMPLEMENTATION, colliding with engine's stb_implementation.cpp.
# Same workaround PSP uses for newlib/pspkernel strtol collisions.
EE_LDFLAGS = $(EE_LIBDIR) -Wl,--allow-multiple-definition
EE_LIBS = \
    -lgskit_toolkit -lgskit -ldmakit \
    -lpacket2 -ldma \
    -laudsrv -lpad -lmc \
    -lfileXio -lpatches -ldebug -lcdvd \
    -lm -lc -lkernel -latomic \
    $(addprefix -l,$(ADDON_LIBS))
# -laudsrv: EE-side stubs that RPC into the audsrv IRX (loaded by
# Main_PS2.cpp via SifLoadModuleBuffer from the embedded blob).
# -latomic: engine's std::atomic<uint64_t>/atomic<bool> calls need libatomic
# for sub-word RMW intrinsics (__atomic_fetch_add_4, __atomic_exchange_1) that
# the EE GCC backend doesn't lower to native MIPS atomic instructions.
# Library filenames are all-lowercase under $(PS2DEV)/gsKit/lib/ (libgskit.a,
# libdmakit.a) despite docs and headers using mixed-case GSGLOBAL/GSKIT_*.

# ---- Master rules + binary --------------------------------------------------
EE_BIN = $(TARGET).elf

# Default target MUST be declared before including Makefile.eeglobal_cpp.
# The include defines a rule for $(EE_BIN) at line 75 — and GNU make picks
# the FIRST target encountered in the file as default. Without declaring
# `all: stage` here, the default becomes $(EE_BIN), which builds the ELF
# in Intermediate/PS2/ but never copies it to Build/PS2/.
.DEFAULT_GOAL := all
all: stage

# Makefile.pref defines the toolchain variables (EE_CC, EE_CXX, EE_LD, EE_AR,
# EE_TOOL_PREFIX = mips64r5900el-ps2-elf-, etc.) — without it, EE_CXX is
# empty and the compile recipe expands as `-D_EE -G0 ... -c file.cpp -o file.o`,
# which the shell parses with the leading `-` stripped, ending up as
# `D_EE: command not found` (error 127). Sample Makefiles always include
# Makefile.pref BEFORE Makefile.eeglobal[_cpp]; we do the same.
include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal_cpp

# Header dependencies written by -MMD (see DEPFLAGS). Non-fatal so the first
# build, before any .d exists, still works.
-include $(EE_OBJS:.o=.d)

# ---- Stage final ELF for the addon's GetCompiledBinaryPath ------------------
# Master include builds $(EE_BIN) in $(CURDIR); we copy it to
# $(PROJECT_ROOT)/Build/PS2/ so the rest of the build-target pipeline finds it.
stage: $(EE_BIN)
	@mkdir -p $(PROJECT_ROOT)/Build/PS2
	@cp $(EE_BIN) $(PROJECT_ROOT)/Build/PS2/$(TARGET).elf
	@echo "Staged $(PROJECT_ROOT)/Build/PS2/$(TARGET).elf"

cleanstage:
	@rm -rf $(PROJECT_ROOT)/Build/PS2
